# Copy to API/.env and fill in. .env is git-ignored and must never be committed.

# Signs dashboard sign-in tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

PORT=3001
DATABASE_URL=./data/onboarding.db
TOKEN_LIFETIME=2h

# Browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
