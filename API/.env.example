# Copy to API/.env and fill in. .env is git-ignored and must never be committed.

# Signs dashboard sign-in tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

PORT=3001
DATABASE_URL=./data/onboarding.db
TOKEN_LIFETIME=2h

# Browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Where the dashboard is served. Links in referral SMS messages point here.
PUBLIC_APP_URL=http://localhost:5173
REFERRAL_LIFETIME_DAYS=14

# SMS provider for referral links. Leave unset to run without SMS: sending a
# referral then fails with "SMS not configured" and nothing is reported as
# sent. No provider is implemented yet - see src/sms/index.js.
# SMS_PROVIDER=
