# Settings for `docker compose`. Copy to .env (git-ignored) and fill in.

# Required. Signs dashboard sign-in tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Host ports. Change them if 8090 or 3001 are taken (for example by
# `npm run api` running at the same time).
WEB_PORT=8090
API_PORT=3001

# The dashboard's address as browsers reach it.
CORS_ORIGINS=http://localhost:8090
PUBLIC_APP_URL=http://localhost:8090

# The API's address as partners' websites reach it; embed tags point here.
# Used when the dashboard image is built (rebuild after changing it).
PUBLIC_API_ORIGIN=http://localhost:3001

TOKEN_LIFETIME=2h
REFERRAL_LIFETIME_DAYS=14
